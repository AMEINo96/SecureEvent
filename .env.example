# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Supabase PostgreSQL connection (get from Supabase Dashboard > Settings > Database) ---
DB_HOST=your-supabase-host.supabase.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_NAME=postgres

# --- Flask secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
SECRET_KEY=generate-a-random-hex-string-here
TICKET_KEY=generate-another-random-hex-string-here

# --- Security mode toggle ---
# Set to "true" for secure demo, "false" for vulnerable demo
SECURE_MODE=true
